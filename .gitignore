# Environment variables (contains plaintext config)
.env

# Certificate output (temporary plaintext certs)
k8s-pki/
kubeconfig*

# Build outputs
result
result-*

# Nix
.direnv/

# Editor files
*.swp
*.swo
*~
.vscode/
.idea/

# Initrd SSH keys - NEVER COMMIT
# Store in password manager instead
secrets/initrd/

# Temporary decrypted secrets
secrets/*.pem
secrets/*.key
secrets/*.crt
secrets/*.kubeconfig

# Rekeyed secrets (local storage mode)
secrets/rekeyed/

# Generated secrets
secrets/generated/

# Don't ignore master secrets (encrypted with YubiKey)
!secrets/*.age